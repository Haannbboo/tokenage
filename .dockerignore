# Allow only the server image's inputs. Private/operator files never enter context.
*
!src/
!src/**
# After `!src/**`: the operator's own config must not enter the build context.
src/config/config.yaml
src/config/*.local.yaml
!protocol/
!protocol/**
!frontend/
!frontend/**
!docker/
!docker/entrypoint.sh
!install.sh
!VERSION
**/__pycache__/
**/*.pyc
frontend/node_modules/
frontend/dist/
