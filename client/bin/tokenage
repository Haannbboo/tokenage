#!/usr/bin/env bash
# tokenage launcher
# The one installed command. This marker line lets an installer recognise a
# launcher it previously wrote, and replace it.
#
# Either component may be installed alone. This script finds each under
# $TOKENAGE_HOME (client: `current`, server: `src`) and routes to whichever one
# the arguments call for. The server install links it into its clone; the client
# install copies it to ~/.local/bin, so it must not depend on its own location.
set -euo pipefail

TRACKER_HOME="${TOKENAGE_HOME:-$HOME/.tokenage}"
BIN_DIR="${TOKENAGE_BIN_DIR:-$HOME/.local/bin}"
REPOSITORY="Haannbboo/tokenage"

# ── Locate the server component ─────────────────────────────────────────────
# TOKENAGE_ROOT wins so a worktree or a test can point at any checkout.
server_root() {
  local candidate
  for candidate in "${TOKENAGE_ROOT:-}" "${TRACKER_HOME}/src"; do
    [[ -n "$candidate" && -x "${candidate}/.venv/bin/python" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}

# ── Locate the client component ─────────────────────────────────────────────
client_root() {
  local link resolved
  link="${TRACKER_HOME}/current"
  [[ -L "$link" ]] || return 1
  resolved="$(readlink "$link")"
  case "$resolved" in
    /*) ;;
    *) resolved="${TRACKER_HOME}/${resolved}" ;;
  esac
  [[ -d "${resolved}/client" ]] || return 1
  printf '%s' "$resolved"
}

# Choose one client source, with its own interpreter: an explicit checkout, else
# the installed snapshot. The client never runs from the server clone.
active_client_root() {
  local candidate
  if [[ -n "${TOKENAGE_ROOT:-}" ]]; then
    candidate="$TOKENAGE_ROOT"
  else
    candidate="$(client_root)" || return 1
  fi
  [[ -d "${candidate}/client" && -x "${candidate}/.venv/bin/python" ]] || return 1
  printf '%s' "$candidate"
}

client_commit() {
  local root="$1"
  if [[ -f "${root}/client/COMMIT" ]]; then
    cat "${root}/client/COMMIT"
  else
    git -C "$root" rev-parse HEAD 2>/dev/null || true
  fi
}

missing_client() {
  cat >&2 <<EOF
tokenage: the client component is not installed on this machine.
Install it with:
  curl -fsSL https://YOUR_SERVER/install.sh | sh
EOF
  exit 1
}

missing_server() {
  cat >&2 <<EOF
tokenage: the server component is not installed on this machine.
This machine has the client only, which reports to a remote server.
To run a local server, install it:
  curl -fsSL https://raw.githubusercontent.com/${REPOSITORY}/main/install.sh | bash -s -- --server
EOF
  exit 1
}

# ── Banner ──────────────────────────────────────────────────────────────────
# Printed by the launcher so every command starts the same way, and only once.
print_banner() {
  # The banner is decoration: it goes to stderr so a tracked child's stdout is
  # exactly what the child wrote. A machine-readable flag suppresses it.
  [[ -t 2 ]] || return 0
  local arg
  for arg in "$@"; do
    case "$arg" in
      --json|--usage-only|--no-banner) return 0 ;;
      --summary-dest)
        return 0
        ;;
    esac
  done
  [[ -n "${TOKENAGE_SKIP_BANNER:-}" ]] && return 0

  printf '\n\033[1;35m' >&2
  cat >&2 <<'ART'
  ████████  ██████  ██   ██ ███████ ███    ██  █████   ██████  ███████
     ██    ██    ██ ██  ██  ██      ████   ██ ██   ██ ██       ██
     ██    ██    ██ █████   █████   ██ ██  ██ ███████ ██   ███ █████
     ██    ██    ██ ██  ██  ██      ██  ██ ██ ██   ██ ██    ██ ██
     ██     ██████  ██   ██ ███████ ██   ████ ██   ██  ██████  ███████
ART
  printf '\033[0m\n' >&2
}

# ── Version ─────────────────────────────────────────────────────────────────
print_version() {
  local active root
  active="$(active_client_root)" || missing_client
  root="$(server_root 2>/dev/null || true)"
  local line="tokenage $(cat "${active}/client/VERSION")"
  local commit
  commit="$(client_commit "$active")"
  if [[ -n "$commit" ]]; then
    line+=" (client ${commit:0:7})"
  else
    line+=" (client)"
  fi
  if [[ -n "$root" && -f "${root}/VERSION" ]]; then
    line+=" · server $(cat "${root}/VERSION")"
  fi
  printf '%s\n' "$line"
}

# ── Routes ──────────────────────────────────────────────────────────────────
run_client() {
  local active python
  active="$(active_client_root)" || missing_client
  python="${active}/.venv/bin/python"
  export TOKENAGE_CLIENT_COMMIT="$(client_commit "$active")"
  export PYTHONPATH="${active}${PYTHONPATH:+:${PYTHONPATH}}"
  export TOKENAGE_SKIP_BANNER=1
  exec "$python" -P -m client "$@"
}

run_server_script() {
  local name="$1"
  shift
  local root
  root="$(server_root)" || missing_server
  [[ -f "${root}/src/scripts/${name}.sh" ]] || missing_server
  exec bash "${root}/src/scripts/${name}.sh" "$@"
}

# Everything but bootstrap runs in the server's own Python (src/ops.py, src/cli.py).
run_server_python() {
  local root
  root="$(server_root)" || missing_server
  export PYTHONPATH="${root}${PYTHONPATH:+:${PYTHONPATH}}"
  # -P so a checkout the user happens to be standing in cannot shadow this one.
  exec "${root}/.venv/bin/python" -P -m src.cli "$@"
}

run_server() {
  local arg
  local -a server_args=()
  for arg in "$@"; do
    [[ "$arg" == "--no-banner" ]] || server_args+=("$arg")
  done
  # ${var[@]+"${var[@]}"}: an empty array must not trip set -u on bash 3.2.
  set -- ${server_args[@]+"${server_args[@]}"}
  local sub="${1:-}"
  if [[ -z "$sub" || "$sub" == "-h" || "$sub" == "--help" ]]; then
    cat >&2 <<EOF
usage: tokenage server <command>

  bootstrap              install, build the dashboard, start, verify
  start                  turn the services on
  stop [program...]      stop all services, or the named ones
  restart [program...]   reload running services (program: tokenage-api)
  status [program...]    supervisord table, ports, port check
  update [--check|--dry-run]
                         fast-forward the server clone, bootstrap, restart
  token create ...       mint an operator token
  login-link             one-time browser sign-in link (local provider)
EOF
    return 2
  fi
  case "$sub" in
    bootstrap) shift; run_server_script bootstrap "$@" ;;
    start|stop|restart|status|update|token|login-link) shift; run_server_python "$sub" "$@" ;;
    *)
      printf 'tokenage: unknown server command: %s\n' "$sub" >&2
      return 2
      ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    print_banner
    run_client --help
    return $?
  fi

  case "$1" in
    --version|-V)
      print_banner "$@"
      print_version
      return 0
      ;;
    -h|--help|help)
      print_banner "$@"
      run_client --help
      return $?
      ;;
    server)
      shift
      print_banner "$@"
      run_server "$@"
      return $?
      ;;
    *)
      print_banner "$@"
      run_client "$@"
      return $?
      ;;
  esac
}

main "$@"
